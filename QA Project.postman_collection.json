            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Id exists\", function () {\r\n    pm.expect(response).to.have.property(\"id\");\r\n});\r\npm.test(\"Id is correct\", function () {\r\n    pm.expect(response.id).to.eql(pm.environment.get(\"userId\"));\r\n});\r\npm.test(\"name exists\", function () {\r\n    pm.expect(response).to.have.property(\"name\");\r\n});\r\npm.test(\"name is correct\", function () {\r\n    pm.expect(response.name).to.eql(pm.environment.get(\"createdName\"));\r\n});\r\npm.test(\"email exists\", function () {\r\n    pm.expect(response).to.have.property(\"email\");\r\n});\r\npm.test(\"email is correct\", function () {\r\n    pm.expect(response.email).to.eql(pm.environment.get(\"createdEmail\"));\r\n});\r\npm.test(\"role exists\", function () {\r\n    pm.expect(response).to.have.property(\"role\");\r\n});\r\npm.test(\"role is correct\", function () {\r\n    pm.expect(response.role).to.eql(pm.environment.get(\"roleUser\"));\r\n});"
            ]
