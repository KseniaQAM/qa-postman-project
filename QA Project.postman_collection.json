      "name": "01-create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json ();\r\npm.environment.set(\"userId\", response.id);\r\npm.environment.set(\"createdName\", response.name);\r\npm.environment.set(\"createdEmail\", response.email);\r\npm.environment.set(\"roleUser\", response.role);\r\npm.test(\"status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\npm.test(\"id exists\", function () {\r\n    pm.expect(response).to.have.property(\"id\");\r\n});\r\npm.test(\"id is number\", function () {\r\n    pm.expect(response.id).to.be.a(\"number\");\r\n});\r\npm.test(\"name exists\", function () {\r\n    pm.expect(response).to.have.property(\"name\");\r\n});\r\npm.test(\"name is string\", function () {\r\n    pm.expect(response.name).to.be.a(\"string\");\r\n});\r\npm.test(\"email exists\", function () {\r\n    pm.expect(response).to.have.property(\"email\");\r\n});\r\npm.test(\"email is string\", function () {\r\n    pm.expect(response.email).to.be.a(\"string\");\r\n});\r\npm.test(\"role exists\", function () {\r\n    pm.expect(response).to.have.property(\"role\");\r\n});\r\npm.test(\"role is string\", function () {\r\n    pm.expect(response.role).to.be.a(\"string\");\r\n});\r\npm.test(\"role is user\", function () {\r\n    pm.expect(response.role).to.eql(\"user\");\r\n});\r\n"
            ]
          }
        }
      ],
